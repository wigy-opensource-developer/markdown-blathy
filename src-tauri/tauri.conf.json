{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkdownBláthy",
  "version": "0.1.0",
  "identifier": "com.csodafon.markdown-blathy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkdownBláthy",
        "backgroundColor": [
          24,
          89,
          217,
          255
        ],
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown editor with Typst-powered live preview and PDF export",
    "longDescription": "MarkdownBláthy is a desktop Markdown editor with live preview and on-demand PDF export. The preview and the PDF are produced by the same Typst compilation pipeline, so what you see is what you get. The name commemorates Ottó Titusz Bláthy who among his other inventions became the co-inventor of the efficient alternating current transformer.",
    "copyright": "Copyright © 2026 wigy-opensource-developer",
    "publisher": "wigy-opensource-developer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "editors"
      }
    }
  }
}
